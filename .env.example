# Environment variables for YT Downloader
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file.

# Flask secret key — change this to a long random string in production
SECRET_KEY=change-me-to-a-long-random-string

# Directory where downloaded files are temporarily stored
DOWNLOAD_DIR=downloads

# Maximum simultaneous downloads (keep low to protect server resources)
MAX_CONCURRENT_DOWNLOADS=3

# How long (seconds) before completed/cancelled/failed jobs are cleaned up
JOB_EXPIRATION=3600

# Flask environment — 'production' or 'development'
FLASK_ENV=development

# Maximum requests per minute per IP (simple in-process rate limiter)
MAX_REQUESTS_PER_MINUTE=10

# Public site URL (used in robots.txt, sitemap.xml, canonical URLs, Open Graph)
SITE_URL=https://your-domain.com
